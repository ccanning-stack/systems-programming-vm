#include "common_hdrs.h"
#include <ctype.h>

bool isValidHex(char arg){

	size_t argLength = strlen(arg);

	for (int i = 0; i < argLength; i++){

		if (isxdigit(arg[i]) == 0)
			return false;
	} else {return true;}
}


